{
  "name": "Legitimate Office Workflow",
  "actor": "agent-1",
  "description": "Authorized document read, notes save, and internal team notification",
  "steps": [
    {
      "action": "read_file",
      "resource": "vendor-invoice.txt",
      "owner": "agent-1"
    },
    {
      "action": "write_file",
      "resource": "notes.txt",
      "owner": "agent-1",
      "content": "Invoice Acme Supplies $420 processed"
    },
    {
      "action": "send_email",
      "resource": "confidential-report.txt",
      "recipient": "finance@internal.example",
      "confidential": true,
      "content": "Processed invoice notification for internal finance team"
    }
  ]
}
